# Copy to .env and fill in. Never commit .env.

# --- NVIDIA NIM (OpenAI-compatible endpoint) --------------------------------
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Extraction model. Everything on NIM is OpenAI-compatible, so switching is a
# string change — no code path is model-specific.
#
# Checked 2026-08-31 with `python extractor.py --list-models`:
#   z-ai/glm-5.2                    NOT in the NIM catalogue (no GLM models are)
#   deepseek-ai/deepseek-v4-pro     published as ...-v4-pro-0813
# Verified working ids:
#   LLM_MODEL=deepseek-ai/deepseek-v4-pro-0813     <- default
#   LLM_MODEL=deepseek-ai/deepseek-v4-flash-0731
#   LLM_MODEL=moonshotai/kimi-k3
#   LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL=deepseek-ai/deepseek-v4-pro-0813

# Free tier is ~40 requests/min shared across models.
NIM_RPM=40

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key
FARES_TABLE=fares

# --- Crawl politeness (defaults shown) --------------------------------------
REQUEST_DELAY_MIN_S=3
REQUEST_DELAY_MAX_S=5
MAX_RETRIES=2
RETRY_BACKOFF_S=8
PAGE_TIMEOUT_MS=60000
HEADLESS=1
